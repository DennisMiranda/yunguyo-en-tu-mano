{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/phases.md",
    "~/.agents/skills/learning-book/LEARNINGS.md"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["bunx", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false
    },
    "supabase-mcp-server": {
      "type": "local",
      "command": [
        "bunx",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "YOUR_TOKEN_HERE"
      ],
      "enabled": true
    }
  }
}
